# Скопируй: cp .env.example .env.local

# false = ходить в Laravel; true = mock в localStorage (по умолчанию)
NEXT_PUBLIC_USE_MOCK_API=false

# Базовый URL API для браузера. /api = через прокси Next (без CORS)
NEXT_PUBLIC_API_BASE_URL=/api

# Куда Next проксирует /api/* (только dev / build rewrites)
WIREHIRE_API_ORIGIN=http://127.0.0.1:8000
